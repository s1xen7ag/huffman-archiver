* text=auto
# Командні файли Windows мають мати закінчення рядків CRLF, інакше cmd може їх неправильно прочитати
*.bat text eol=crlf
# Тестові файли зберігаються байт у байт: інакше Git на Windows змінив би закінчення рядків,
# а з ними розміри файлів і відсотки стиснення, описані в examples/README.md
examples/** -text
